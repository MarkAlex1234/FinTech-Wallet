<!doctype html>
<html>
  <body style="font-family: Arial, sans-serif; background:#f2f4f6; padding:20px;">
    <h2>Verify your email</h2>
    <p>Hi <strong>{{name}}</strong>,</p>
    <p>Your verification code is:</p>
    <div style="background:#f9fafb; padding:15px; border-radius:5px; text-align:center;">
      <span style="font-size:22px; font-weight:bold; letter-spacing:4px;">{{code}}</span>
    </div>
    <p>Or click below:</p>
    <a href="{{link}}" style="display:inline-block; padding:10px 20px; background:#2563eb; color:#fff; text-decoration:none; border-radius:5px;">Verify Email</a>
    <p>If you didn't request this, ignore this message.</p>
  </body>
</html>
